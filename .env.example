# Public Cloudflare Worker base URL (from `wrangler deploy` in workers/writing-api)
WORKER_URL=https://keiryuuzaki-writing-api.<your-subdomain>.workers.dev

# Must match the ADMIN_TOKEN secret set on the Worker
WORKER_ADMIN_TOKEN=

# Password to log into /studio
STUDIO_PASSWORD=

# Random long string used to sign the /studio session cookie
SESSION_SECRET=
